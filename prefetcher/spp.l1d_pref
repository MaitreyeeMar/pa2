#include "cache.h"

/*
 * Stride Pattern Prefetcher (SPP) for L1D  --  CS683 PA2, Task 1B
 *
 * Per-IP prefetcher with two modes:
 *   UNIFORM     : the IP keeps repeating the same stride (A, A+2, A+4 ...).
 *                 Same idea as ip_stride but with a 2-bit confidence counter.
 *   NON-UNIFORM : the IP repeats a stride *sequence*, e.g. (+1,+2,+2,+2,+3)^n.
 *                 We keep a signature = hash of the last few strides of the IP
 *                 and a Pattern Table (PT) that maps signature -> next stride.
 *                 For degree > 1 we walk the PT: predict stride, update a copy
 *                 of the signature with it, look up again, ...
 *
 * Uniform has priority. An IP moves to the non-uniform path when its uniform
 * prediction keeps failing while the PT prediction is right (nu bit below).
 *
 * Accuracy throttling: every prefetch we issue is remembered in a small
 * prefetch filter. A later demand load to a line in the filter = useful
 * prefetch. Every EPOCH issued prefetches we compute accuracy and pick the
 * degree for the next epoch.
 *
 * Prefetches never cross the 4KB page of the triggering access.
 * Addresses here are virtual (this ChampSim prefetches at L1D in VA space).
 */

// ---------------- parameters ----------------
#define IPT_SETS        16
#define IPT_WAYS        4          // 64 IP entries total
#define IPT_TAG_BITS    10
#define LAST_LINE_BITS  16         // low bits of last cache-line address
#define STRIDE_MAX      63         // |stride| > 63 lines can never stay in a 4KB page
#define SIG_BITS        12
#define SIG_SHIFT       3
#define PT_ENTRIES      512
#define CONF_MAX        3          // 2-bit counters

#define FILTER_ENTRIES  128        // prefetch filter / accuracy checker
#define FILTER_TAG_BITS 9

#define EPOCH           256        // prefetches per accuracy epoch

// accuracy thresholds (percent) and the degree used in each range
#ifndef ACC_HI
#define ACC_HI   75
#endif
#ifndef ACC_MID
#define ACC_MID  50
#endif
#ifndef ACC_LO
#define ACC_LO   30
#endif
#define DEG_HI   6
#define DEG_MID  4
#define DEG_LO   2
#define DEG_MIN  1                 // never 0: we still need samples to measure accuracy
#define DEG_INIT 4

// ---------------- tables ----------------
struct ipt_entry_t {
    uint8_t  valid;
    uint16_t tag;          // IPT_TAG_BITS
    uint16_t last_line;    // LAST_LINE_BITS
    int8_t   stride;       // 7 bits, signed
    uint8_t  uconf;        // 2 bits, uniform-stride confidence
    uint16_t sig;          // SIG_BITS, history of recent strides
    uint8_t  nu;           // 1 bit, 1 = this IP looks non-uniform
    uint8_t  lru;          // 2 bits
};

struct pt_entry_t {
    int8_t  stride;        // 7 bits, predicted next stride
    uint8_t conf;          // 2 bits
};

struct filter_entry_t {
    uint8_t  valid;
    uint16_t tag;          // FILTER_TAG_BITS
};

static ipt_entry_t    ipt[IPT_SETS][IPT_WAYS];
static pt_entry_t     pt[PT_ENTRIES];
static filter_entry_t pf_filter[FILTER_ENTRIES];

static uint32_t epoch_issued = 0, epoch_useful = 0;   // 8 + 9 bits in hardware
static uint32_t cur_degree = DEG_INIT;                 // 3 bits

// stats only (not part of the hardware budget)
static uint64_t st_uniform = 0, st_nonuniform = 0, st_epochs = 0;
static uint64_t st_deg_hist[DEG_HI + 1];

// ---------------- helpers ----------------
static inline uint32_t ip_hash(uint64_t ip) { return (uint32_t)(ip ^ (ip >> 13) ^ (ip >> 27)); }

// encode a stride as 7 bits (sign + 6-bit magnitude) like the original SPP paper
static inline uint32_t stride_code(int s) { return s < 0 ? (0x40 | (uint32_t)(-s)) : (uint32_t)s; }

static inline uint16_t next_sig(uint16_t sig, int s)
{
    return (uint16_t)(((sig << SIG_SHIFT) ^ stride_code(s)) & ((1 << SIG_BITS) - 1));
}

static inline uint32_t pt_index(uint16_t sig) { return (sig ^ (sig >> 9)) & (PT_ENTRIES - 1); }

static inline uint32_t filt_idx(uint64_t line) { return line & (FILTER_ENTRIES - 1); }
static inline uint16_t filt_tag(uint64_t line) { return (line >> 7) & ((1 << FILTER_TAG_BITS) - 1); }

static bool filter_hit(uint64_t line)
{
    filter_entry_t &f = pf_filter[filt_idx(line)];
    return f.valid && f.tag == filt_tag(line);
}

static void update_degree()
{
    uint32_t acc = (epoch_useful * 100) / EPOCH;
    if (acc >= ACC_HI)       cur_degree = DEG_HI;
    else if (acc >= ACC_MID) cur_degree = DEG_MID;
    else if (acc >= ACC_LO)  cur_degree = DEG_LO;
    else                     cur_degree = DEG_MIN;
    epoch_issued = epoch_useful = 0;
    st_epochs++;
}

// issue one prefetch (if it stays in the page and was not prefetched recently)
// returns false if we should stop (left the page)
static bool try_prefetch(CACHE *c, uint64_t ip, uint64_t addr, uint64_t pf_line)
{
    uint64_t pf_addr = pf_line << LOG2_BLOCK_SIZE;
    if ((pf_addr >> LOG2_PAGE_SIZE) != (addr >> LOG2_PAGE_SIZE))
        return false;

    if (filter_hit(pf_line))          // already asked for this line, don't waste PQ slot
        return true;

    // same fill-level choice as the given ip_stride code
    int fill = (c->MSHR.occupancy < (c->MSHR.SIZE >> 1)) ? FILL_L1 : FILL_L2;
    if (c->prefetch_line(ip, addr, pf_addr, fill, 0)) {
        filter_entry_t &f = pf_filter[filt_idx(pf_line)];
        f.valid = 1;
        f.tag = filt_tag(pf_line);
        if (++epoch_issued == EPOCH)
            update_degree();
    }
    return true;
}

// ---------------- ChampSim hooks ----------------
void CACHE::l1d_prefetcher_initialize()
{
    std::cout << "------------------------------------------------" << std::endl;
    std::cout << "        Stride Pattern Prefetcher (SPP)         " << std::endl;
    std::cout << "------------------------------------------------" << std::endl;

    for (int s = 0; s < IPT_SETS; s++)
        for (int w = 0; w < IPT_WAYS; w++) {
            ipt[s][w] = ipt_entry_t();
            ipt[s][w].lru = w;
        }
    for (int i = 0; i < PT_ENTRIES; i++) { pt[i].stride = 0; pt[i].conf = 0; }
    for (int i = 0; i < FILTER_ENTRIES; i++) pf_filter[i].valid = 0;
    for (int i = 0; i <= DEG_HI; i++) st_deg_hist[i] = 0;
}

void CACHE::l1d_prefetcher_operate(uint64_t addr, uint64_t ip, uint8_t cache_hit, uint8_t type, uint8_t critical_ip_flag)
{
    if (type != LOAD)       // train only on demand loads
        return;

    uint64_t line = addr >> LOG2_BLOCK_SIZE;

    // ---- accuracy checker: demand access to a line we prefetched => useful ----
    // (counts late prefetches too, the line was still the right one to fetch)
    filter_entry_t &f = pf_filter[filt_idx(line)];
    if (f.valid && f.tag == filt_tag(line)) {
        f.valid = 0;
        if (epoch_useful < EPOCH) epoch_useful++;
    }

    // ---- IP table lookup ----
    uint32_t h = ip_hash(ip);
    uint32_t set = h % IPT_SETS;
    uint16_t tag = (h / IPT_SETS) & ((1 << IPT_TAG_BITS) - 1);
    int way = -1;
    for (int w = 0; w < IPT_WAYS; w++)
        if (ipt[set][w].valid && ipt[set][w].tag == tag) { way = w; break; }

    if (way < 0) {
        // miss: replace LRU entry, nothing to predict yet
        for (int w = 0; w < IPT_WAYS; w++)
            if (ipt[set][w].lru == IPT_WAYS - 1) { way = w; break; }
        ipt_entry_t &n = ipt[set][way];
        n.valid = 1; n.tag = tag;
        n.last_line = line & ((1 << LAST_LINE_BITS) - 1);
        n.stride = 0; n.uconf = 0; n.sig = 0; n.nu = 0;
    }

    // update LRU (move to MRU)
    for (int w = 0; w < IPT_WAYS; w++)
        if (ipt[set][w].lru < ipt[set][way].lru) ipt[set][w].lru++;
    ipt[set][way].lru = 0;

    ipt_entry_t &e = ipt[set][way];

    // stride from the stored low bits (sign-extended difference)
    int32_t d = (int32_t)((line - e.last_line) & ((1 << LAST_LINE_BITS) - 1));
    if (d >= (1 << (LAST_LINE_BITS - 1))) d -= (1 << LAST_LINE_BITS);

    if (d == 0)             // same line again, nothing new to learn
        return;
    e.last_line = line & ((1 << LAST_LINE_BITS) - 1);

    if (d > STRIDE_MAX || d < -STRIDE_MAX) {
        // big jump (new region / new page). Patterns restart from here.
        e.uconf = 0;
        e.sig = 0;
        return;
    }

    // ---- train ----
    // was each predictor right about this stride?
    pt_entry_t &p_old = pt[pt_index(e.sig)];
    bool uni_ok = (e.stride == d);
    bool pt_ok  = (p_old.conf > 0 && p_old.stride == d);

    // nu bit: set when the pattern table beats the uniform stride, cleared when
    // uniform beats the pattern table
    if (pt_ok && !uni_ok) e.nu = 1;
    else if (uni_ok && !pt_ok) e.nu = 0;

    // uniform stride, 2-bit hysteresis: only replace the stride when conf drops to 0
    if (uni_ok) {
        if (e.uconf < CONF_MAX) e.uconf++;
    } else {
        if (e.uconf > 0) e.uconf--;
        if (e.uconf == 0) e.stride = d;
    }
    if (e.uconf == CONF_MAX) e.nu = 0;   // clearly uniform again

    // pattern table: signature (old history) -> this stride
    if (p_old.stride == d) {
        if (p_old.conf < CONF_MAX) p_old.conf++;
    } else {
        if (p_old.conf > 0) p_old.conf--;
        if (p_old.conf == 0) { p_old.stride = d; p_old.conf = 1; }
    }
    e.sig = next_sig(e.sig, d);

    // ---- predict ----
    // Uniform first. With the nu bit set we want the uniform counter saturated,
    // otherwise a short run like +2,+2,+2 inside (+1,+2,+2,+2,+3) would look uniform.
    bool use_uniform = (e.uconf == CONF_MAX) || (e.uconf >= 2 && !e.nu);

    if (use_uniform) {
        st_uniform++;
        for (uint32_t i = 1; i <= cur_degree; i++)
            if (!try_prefetch(this, ip, addr, line + (int64_t)e.stride * i))
                break;
    } else {
        // walk the signature path through the PT
        uint16_t sig = e.sig;
        uint64_t pf_line = line;
        uint32_t issued = 0;
        for (uint32_t i = 0; i < cur_degree; i++) {
            pt_entry_t &p = pt[pt_index(sig)];
            if (p.conf < 2)          // not confident about the next stride, stop here
                break;
            pf_line += p.stride;
            if (!try_prefetch(this, ip, addr, pf_line))
                break;
            issued++;
            sig = next_sig(sig, p.stride);
        }
        if (issued) st_nonuniform++;
    }
    st_deg_hist[cur_degree]++;
}

void CACHE::l1d_prefetcher_cache_fill(uint64_t v_addr, uint64_t addr, uint32_t set, uint32_t way, uint8_t prefetch, uint64_t v_evicted_addr, uint64_t evicted_addr, uint32_t metadata_in)
{
    return;
}

void CACHE::l1d_prefetcher_final_stats()
{
    cout << "SPP: uniform-mode triggers: " << st_uniform
         << "  non-uniform-mode triggers: " << st_nonuniform
         << "  epochs: " << st_epochs << endl;
    cout << "SPP: degree histogram (per trigger):";
    for (int i = 1; i <= DEG_HI; i++) cout << " d" << i << "=" << st_deg_hist[i];
    cout << endl;
}
